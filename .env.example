# WhiteBIT API (not needed for paper-trading, kept for reference)
API_KEY=YOUR_API_KEY
API_SECRET=YOUR_API_SECRET

# Exchange endpoints
BASE_URL=https://whitebit.com
WS_URL=wss://api.whitebit.com/ws

# Trading pair
MARKET=DBTC_DUSDT

# Paper-trading initial balances
INITIAL_BALANCE_QUOTE=500.0
INITIAL_BALANCE_BASE=0.0

# Grid parameters
GRID_LEVELS=5
GRID_SPACING=200.0
ORDER_SIZE=0.0005
MIN_ORDER_SIZE=0.00001
ORDER_STEP=0.000001

# Fees (as fractions, e.g. 0.0007 = 0.07%, 0.00095 = 0.095%)
MAKER_FEE=0.0007
TAKER_FEE=0.00095

# Slippage simulation (fraction, e.g. 0.0003 = 0.03%)
SLIPPAGE_PCT=0.0003

# Data freshness threshold (seconds)
DATA_STALE_SECONDS=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot_dca.log
